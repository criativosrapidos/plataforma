# Banco (Supabase em produção: use a connection string do pooler, modo transaction)
DATABASE_URL=postgres://aviso:aviso@localhost:5432/aviso
# Segredo para assinar sessões (gere com: openssl rand -base64 48)
AUTH_SECRET=troque-este-segredo-em-producao-com-48-bytes-aleatorios
# URL pública do site
APP_URL=http://localhost:3000
# Segredo dos jobs agendados (Vercel Cron manda Authorization: Bearer $CRON_SECRET)
CRON_SECRET=troque
# IA (extração e Pergunte ao edital). Sem chave, roda um extrator heurístico de desenvolvimento.
ANTHROPIC_API_KEY=
# Coleta
INLABS_EMAIL=
INLABS_SENHA=
# Cobrança: mock | asaas
BILLING_PROVIDER=mock
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Push (Expo). Opcional: token de acesso para envio com segurança reforçada
EXPO_ACCESS_TOKEN=
# WhatsApp Business Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# E-mail (Resend)
RESEND_API_KEY=
EMAIL_FROM="Aviso Concurso <avisos@avisoconcurso.com.br>"
WHATSAPP_TEMPLATE_PRAZO=prazo_acabando_amanha
WHATSAPP_API_VERSION=v21.0
# Asaas: 1 ativa o Pix automático (campos a confirmar no sandbox); sem ele, cobrança Pix mensal
ASAAS_PIX_AUTOMATICO=
# Storage dos documentos originais (sem Supabase, grava em disco em STORAGE_DIR, padrão .storage/)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=originais
STORAGE_DIR=
# Coleta a partir de arquivos gravados (dev/testes)
COLETA_FIXTURES_DIR=
# log = só registra os avisos sem enviar (dev)
AVISOS_MODO=
# Banco usado pelos testes de integração
TEST_DATABASE_URL=postgres://aviso:aviso@localhost:5432/aviso_test
# Site público
# Mostra concursos de exemplo do seed (exemplo = true) na busca, no sitemap e nas páginas de concurso.
# Use 1 só em desenvolvimento; em produção deixe vazio.
SHOW_EXEMPLOS=
# Links das lojas. Sem eles, os botões de baixar o app levam para /cadastro.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
