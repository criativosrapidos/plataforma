# URL da API (/api/v1). Em dev aponte para o Next rodando local (apps/web: npm run dev -- -p 3004).
# No celular físico use o IP da máquina na rede (ex.: http://192.168.0.10:3004).
# Produção: https://avisoconcurso.com.br (definido nos perfis do eas.json).
EXPO_PUBLIC_API_URL=http://localhost:3004
# URL do site (gerenciar assinatura, termos e privacidade). Vazio = a mesma da API.
EXPO_PUBLIC_SITE_URL=
